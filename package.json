{
  "name": "digdig-tools",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.9.0",
  "engines": { "node": ">=24.0.0 <25", "npm": ">=11 <12" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "nx run userscript:dev",
    "dev:desktop": "node tools/desktop-dev.mjs",
    "build": "nx run-many -t build",
    "build:desktop": "nx run desktop:native-build",
    "deploy": "node tools/deploy.mjs",
    "check:versions": "node tools/check-versions.mjs",
    "typecheck": "nx run-many -t typecheck",
    "test": "node --test tools/test/*.test.mjs && nx run-many -t test",
    "clients": "node tools/control.mjs clients",
    "report": "node tools/control.mjs report",
    "reload": "node tools/control.mjs reload",
    "analyze:wasm": "node tools/wasm-analysis/src/analyze.mjs"
  },
  "devDependencies": {
    "@types/tampermonkey": "5.5.0",
    "nx": "24.0.1",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "wabt": "1.0.39",
    "webpack": "5.112.2"
  }
}

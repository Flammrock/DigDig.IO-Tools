{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "232e6471a431eb38cb4155267de1908ff3ce52c1",
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "apps/*/package.json", "glob": true, "jsonpath": "$.version" },
        { "type": "json", "path": "packages/*/package.json", "glob": true, "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['apps/desktop'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['apps/dev-server'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['apps/userscript'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/layout-resolver'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/terrain'].version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/userscript-webpack-plugin'].version" },
        { "type": "generic", "path": "apps/desktop/src-tauri/Cargo.toml" },
        {
          "type": "toml",
          "path": "apps/desktop/src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name == 'digdig-desktop' || @.name.value == 'digdig-desktop')].version"
        }
      ]
    }
  }
}
